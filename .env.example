# --- App ---
APP_NAME=AniFlow AI
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite (default for local development):
DATABASE_URL=sqlite:///./aniflow.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://aniflow:aniflow@localhost:5432/aniflow

# --- Storage ---
STORAGE_DIR=./storage

# --- AI ---
# Leave AI_API_KEY empty to use MockAIService (fully usable without paid APIs).
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Seed ---
SEED_ON_STARTUP=true
DEMO_PASSWORD=demo1234
